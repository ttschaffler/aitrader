# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real secrets.

# Anthropic API
ANTHROPIC_API_KEY=

# Finnhub (free tier)
FINNHUB_API_KEY=

# Deutsche Boerse Group developer portal
# Create an app at https://console.developer.deutsche-boerse.com/apis
DBG_API_KEY=

# SMTP for trade + daily summary emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
